# Google Gemini API Key (Generous free tier - https://aistudio.google.com/)
# Optional: AI features fall back to local templates when this is empty.
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude API Key (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Supabase Configuration (Optional - PostgreSQL Database / Auth)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Use either the publishable key or the legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Stripe Configuration (Optional - Pro plans & credit packs)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_UNLIMITED_PRICE_ID=price_your_unlimited_plan_id
STRIPE_CREDITS_PRICE_ID=price_your_credit_pack_id

# Public app URL (Optional - used for metadata and Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
